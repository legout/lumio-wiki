# Copy this file to .env, adjust the values, then run:
#   docker compose up --build -d
# Open http://localhost:${LUMIO_PORT:-8000}/setup to create the first Owner.

# Host port exposed by Docker Compose.
LUMIO_PORT=8000

# Host directory containing a valid compiled Markdown Knowledge Base.
# The included fixture starts Lumio immediately; replace it with your own path.
LUMIO_KB_HOST_PATH=./tests/fixtures/valid

# Canonical storage mode: git, shared, or hybrid.
# Leave the corresponding source values empty to use LUMIO_KB_HOST_PATH directly.
LUMIO_STORAGE_MODE=git
LUMIO_GIT_SOURCE=
# Shared paths are paths inside the container; /knowledge is the mounted host KB.
LUMIO_SHARED_SOURCE=

# First-run seed only: proposal-first or direct-write.
# A persisted Owner selection takes precedence after initialization.
LUMIO_WRITE_MODE=proposal-first

# Optional OpenAI-compatible provider. When URL or model is empty, Lumio uses
# its offline fake provider. For Ollama on the Docker host, for example:
# LUMIO_PROVIDER_BASE_URL=http://host.docker.internal:11434/v1
# LUMIO_PROVIDER_MODEL=llama3.2
# LUMIO_PROVIDER_API_KEY=
LUMIO_PROVIDER_BASE_URL=
LUMIO_PROVIDER_MODEL=
LUMIO_PROVIDER_API_KEY=

# Optional hybrid Knowledge Base retrieval for chat answers (issue #159).
# When a sentence-transformers model name is set, chat answers retrieve with
# hybrid mode (BM25 + cosine + RRF) instead of BM25-only. Requires the
# 'semantic' optional dependency group (sentence-transformers + Torch), loaded
# lazily only when this is set. Separate from LUMIO_RECALL_EMBEDDING_MODEL
# (Conversation Recall, #59): KB retrieval and recall are independent concerns,
# though both may use the same model. Leave unset for BM25-only behavior.
LUMIO_RETRIEVAL_EMBEDDING_MODEL=
# Optional explicit override: 'lexical' (BM25 only) or 'hybrid' (BM25 + cosine
# + RRF). Unset derives the mode from embedder presence (hybrid when a retrieval
# embedder is configured, else lexical). 'lexical' forces BM25 even with an
# embedder set; 'hybrid' without an embedder degrades to BM25. Ignored by the
# zero-index backend.
LUMIO_RETRIEVAL_MODE=
